<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/studyhard_bg</item>
        <!-- The app draws its own dark and light looks: never let the phone recolour it
             (some phones force "dark mode" on every app, which turned text white on white). -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- The theme BridgeActivity switches to once it starts. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/studyhard_bg</item>
        <!-- The app draws its own dark and light looks: never let the phone recolour it
             (some phones force "dark mode" on every app, which turned text white on white). -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Launch: Android 12+ shows the adaptive icon on this colour; older versions show @drawable/splash. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/studyhard_bg</item>
    </style>
</resources>

{
  "name": "study-hard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Study Hard — a maths learning path for children aged 3–16, with rewards, boss fights and Face-off",
  "scripts": {
    "setup:local": "sh scripts/link-tools.sh",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "e2e": "playwright test",
    "simulate": "node scripts/simulate.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e",
    "android": "node scripts/android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "playwright": "1.56.0",
    "typescript": "^6.0.3"
  }
}

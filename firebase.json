{
  "hosting": {
    "public": "_site",
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      { "source": "/admin/**", "headers": [{ "key": "Cache-Control", "value": "no-store" }, { "key": "X-Robots-Tag", "value": "noindex" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
